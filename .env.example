# Grounded backend environment template
# App
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://grounded:grounded@localhost:5432/grounded
ALEMBIC_DATABASE_URL=postgresql+psycopg://grounded:grounded@localhost:5432/grounded

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounded_chunks

# Object storage
# These defaults are for the local MinIO container only.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=grounded-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SECURE=false

# Provider settings
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Security
JWT_SECRET_KEY=replace-in-local-env
API_KEY_SALT=replace-in-local-env
TRACE_ENCRYPTION_KEY=replace-in-local-env

# Telemetry
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
