# App
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
DOCUMENT_UPLOAD_MAX_BYTES=26214400
INGESTION_AUTORUN_ENABLED=true

# Chunking
CHUNKING_STRATEGY=structure_aware_v1
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP_TOKENS=40

# Database (local infra: host port 5433)
DATABASE_URL=postgresql+asyncpg://grounded:grounded@localhost:5433/grounded
ALEMBIC_DATABASE_URL=postgresql+psycopg://grounded:grounded@localhost:5433/grounded
POSTGRES_DB=grounded
POSTGRES_USER=grounded
POSTGRES_PASSWORD=grounded

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounded_chunks
QDRANT_CHECK_COMPATIBILITY=false
EMBEDDING_BACKEND=gemini_v1
DENSE_EMBEDDING_DIMENSIONS=128
RETRIEVAL_CANDIDATE_LIMIT=8
RETRIEVAL_OVERFETCH_FACTOR=4
RRF_SMOOTHING_CONSTANT=60
EVIDENCE_PACKAGE_LIMIT=3

# Object storage (local MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=grounded-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SECURE=false

# Provider
GENERATOR_BACKEND=gemini_v1
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_MS=250

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Security
JWT_SECRET_KEY=replace-in-local-env
API_KEY_SALT=replace-in-local-env
TRACE_ENCRYPTION_KEY=replace-in-local-env

# Telemetry
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true

# Client URL / Email / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ENTERPRISE_ENABLED=true
ENTERPRISE_TRACE_METADATA_ENABLED=true
ENTERPRISE_AUTO_ROUTING_ENABLED=true
ENTERPRISE_RERANKER_ENABLED=true
ENTERPRISE_RERANKER_BACKEND=gemini_v1
ENTERPRISE_RERANKER_CANDIDATE_LIMIT=24
ENTERPRISE_TEMPORAL_SCORING_ENABLED=true
CRITICAL_ENABLED=true
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESEND_API_KEY=
