# Grounded backend environment template
# App
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
DOCUMENT_UPLOAD_MAX_BYTES=26214400
INGESTION_AUTORUN_ENABLED=true

# Chunking
# Recommended Standard default for stronger retrieval quality.
CHUNKING_STRATEGY=structure_aware_v1
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP_TOKENS=40

# Database
DATABASE_URL=postgresql+asyncpg://grounded:grounded@localhost:5433/grounded
ALEMBIC_DATABASE_URL=postgresql+psycopg://grounded:grounded@localhost:5433/grounded

# Redis
# Reserved for upcoming ingestion/worker support.
REDIS_URL=redis://localhost:6379/0

# Qdrant
# Vector retrieval store.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounded_chunks
QDRANT_CHECK_COMPATIBILITY=false
EMBEDDING_BACKEND=local_hash_v1
DENSE_EMBEDDING_DIMENSIONS=128
RETRIEVAL_CANDIDATE_LIMIT=8
RETRIEVAL_OVERFETCH_FACTOR=4
RRF_SMOOTHING_CONSTANT=60
EVIDENCE_PACKAGE_LIMIT=3

# Object storage
# These defaults are for the local MinIO container only.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=grounded-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SECURE=false

# Provider settings
# Safe local defaults. These run without external API keys.
GENERATOR_BACKEND=local_grounded_v1
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_MS=250

# Recommended stronger Standard profile:
# GENERATOR_BACKEND=gemini_v1
# EMBEDDING_BACKEND=gemini_v1
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Optional OpenAI-compatible provider profile:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=30

# Security
# Replace these in real environments. Local placeholders are fine for development.
JWT_SECRET_KEY=replace-in-local-env
API_KEY_SALT=replace-in-local-env
TRACE_ENCRYPTION_KEY=replace-in-local-env

# Telemetry
# Optional external telemetry integration.
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
