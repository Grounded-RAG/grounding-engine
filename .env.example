# App
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://grounded:grounded@localhost:5432/grounded
ALEMBIC_DATABASE_URL=postgresql+psycopg://grounded:grounded@localhost:5432/grounded

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounded_chunks

# Object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=grounded-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SECURE=false

# Security
JWT_SECRET_KEY=replace-me
API_KEY_SALT=replace-me
TRACE_ENCRYPTION_KEY=replace-me

# Telemetry
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
